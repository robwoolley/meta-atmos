{
    "description": "ATMOS: PX4 SITL (x86-64) and Jetson Orin Nano Super companion builds with ROS 2 Jazzy",
    "sources": {
        "bitbake": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://git.openembedded.org/bitbake"
                    }
                },
                "rev": "2.18"
            },
            "path": "bitbake"
        },
        "openembedded-core": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://git.openembedded.org/openembedded-core"
                    }
                },
                "rev": "wrynose"
            },
            "path": "openembedded-core"
        },
        "meta-openembedded": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://git.openembedded.org/meta-openembedded"
                    }
                },
                "rev": "wrynose"
            },
            "path": "meta-openembedded"
        },
        "meta-qt5": {
            "git-remote": {
                "uri": "https://github.com/meta-qt5/meta-qt5.git",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        },
        "meta-ros": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://github.com/ros/meta-ros.git"
                    }
                },
                "rev": "wrynose"
            },
            "path": "meta-ros"
        },
        "meta-tegra": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://github.com/OE4T/meta-tegra.git"
                    }
                },
                "rev": "wrynose"
            },
            "path": "meta-tegra"
        },
        "meta-px4": {
            "git-remote": {
                "remotes": {
                    "origin": {
                        "uri": "https://github.com/robwoolley/meta-px4.git"
                    }
                },
                "rev": "wrynose"
            },
            "path": "meta-px4"
        },
        "meta-virtualization": {
            "git-remote": {
                "uri": "https://git.yoctoproject.org/meta-virtualization",
                "branch": "wrynose",
                "rev": "wrynose"
            }
        }
    },
    "bitbake-setup": {
        "configurations": [
            {
                "bb-layers": [
                    "openembedded-core/meta",
                    "meta-openembedded/meta-filesystems",
                    "meta-openembedded/meta-gnome",
                    "meta-openembedded/meta-initramfs",
                    "meta-openembedded/meta-multimedia",
                    "meta-openembedded/meta-networking",
                    "meta-openembedded/meta-oe",
                    "meta-openembedded/meta-perl",
                    "meta-openembedded/meta-python",
                    "meta-openembedded/meta-webserver",
                    "meta-openembedded/meta-xfce",
                    "meta-qt5",
                    "meta-ros/meta-ros-common",
                    "meta-ros/meta-ros2",
                    "meta-ros/meta-ros2-jazzy",
                    "meta-px4",
                    "meta-virtualization"
                ],
                "configurations": [
                    {
                        "name": "px4-sitl-x86-64",
                        "description": "PX4 SITL + ROS 2 Jazzy + uXRCE-DDS agent development image for qemux86-64",
                        "oe-fragments": [
                            "machine/qemux86-64"
                        ]
                    },
                    {
                        "name": "orin-companion",
                        "description": "Companion computer image for Jetson Orin Nano Super (Pixhawk 6X FMU offboard): ROS 2 Jazzy, uXRCE-DDS agent, px4-msgs, on-target colcon toolchain",
                        "bb-layers": [
                            "meta-tegra"
                        ],
                        "oe-fragments": [
                            "machine/jetson-orin-nano-devkit-nvme"
                        ]
                    }
                ]
            }
        ]
    },
    "version": "1.0"
}
